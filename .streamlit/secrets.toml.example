DATABASE_URL = "postgresql://dfts_app:REPLACE_ME@localhost:5432/dfts"

# Copy to .streamlit/secrets.toml locally; never commit the real secrets file.
# Register this callback URL with your OIDC provider:
# http://localhost:8501/oauth2callback (local) or your HTTPS deployment callback.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
