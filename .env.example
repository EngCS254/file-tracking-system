# Copy to .env and replace every value with a long random secret.
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-long-random-postgres-password
DFTS_APP_PASSWORD=replace-with-a-different-long-random-app-password
DFTS_MIGRATION_PASSWORD=replace-with-a-different-long-random-migration-password
# Temporary one-time token for creating the first administrator; remove after setup.
DFTS_BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-token
